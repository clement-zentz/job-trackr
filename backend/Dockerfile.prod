# backend/Dockerfile.prod

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  DJANGO_SETTINGS_MODULE=job_trackr.settings.prod \
  VIRTUAL_ENV=/app/.venv \
  PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN apt-get update && apt-get install -y \
  --no-install-recommends \
  curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./

RUN uv sync --locked --no-default-groups --no-install-project

COPY . .

# Collect static assets without requiring production runtime configuration.
RUN DJANGO_SETTINGS_MODULE=job_trackr.settings.build \
  python job_trackr/manage.py collectstatic --noinput

RUN adduser --disabled-password --gecos "" appuser

USER appuser

EXPOSE 8000

CMD [ "gunicorn", "--chdir", "/app/job_trackr", "job_trackr.wsgi:application", "--bind", "0.0.0.0:8000" ]
